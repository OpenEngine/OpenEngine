{
  "include": [
    "apps/*/src/engine/**/*.py",
    "cli/*/src/engine/**/*.py",
    "packages/*/src/engine/**/*.py",
    "packages/adapters/*/*/src/engine/**/*.py",
    "tests/typecheck"
  ],
  "extraPaths": [
    "apps/cli/src",
    "apps/control_server/src",
    "apps/mcp_server/src",
    "apps/web/src",
    "apps/worker/src",
    "cli/client/src",
    "cli/service/src",
    "packages/adapters/agent_runner/acp/src",
    "packages/adapters/communications/buzz/src",
    "packages/adapters/communications/slack/src",
    "packages/adapters/sandbox/process/src",
    "packages/adapters/source_control/github/src",
    "packages/adapters/source_control/gitlab/src",
    "packages/adapters/state_store/memory/src",
    "packages/adapters/state_store/postgres/src",
    "packages/adapters/state_store/sqlite/src",
    "packages/adapters/workflow_runtime/temporal/src",
    "packages/adapters/workspace_provider/git_worktree/src",
    "packages/domain/src",
    "packages/github-concierge/src",
    "packages/graph_runtime/src",
    "packages/graph_runtime_langgraph/src",
    "packages/orchestrator/src",
    "packages/ports/src",
    "packages/runtime/src",
    "packages/scoper/src",
    "packages/single-tool-mcp/src",
    "packages/slack-concierge/src"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  "pythonPlatform": "All",
  "venvPath": ".",
  "venv": ".venv",
  "reportUnnecessaryTypeIgnoreComment": "error"
}
