title: OpenEngine V2 architecture
config:
  theme: neutral
  flowchart:
    htmlLabels: true
    wrappingWidth: 600
---
%% Generated by packages/contracts/tooling/architecture.py from the service contracts,
%% their migrations and infra/nats/streams. Do not edit.
flowchart LR
    classDef app fill:#e0e7ff,stroke:#4338ca,color:#1e1b4b
    classDef integration fill:#fce7f3,stroke:#be185d,color:#500724
    classDef subjects fill:#f8fafc,stroke:#64748b,color:#0f172a,text-align:left
    classDef stream fill:#fef3c7,stroke:#b45309,color:#78350f
    classDef table fill:#dcfce7,stroke:#15803d,color:#14532d
    classDef runtime fill:#f1f5f9,stroke:#334155,color:#0f172a

    subgraph apps["Apps"]
        cli["oe CLI"]
        supervisor["supervisor (oe up)"]
    end
    subgraph integrations["Integrations"]
        github["GitHub"]
        slack["Slack"]
    end
    class cli,supervisor app
    class github,slack integration
    nats[("NATS server")]
    class nats stream
    subgraph cxn["Connection Bus (cxn)"]
        cxn_control["NATS control<br/><b>oe.v1.cxn.control.connections.</b><br/>apply<br/>{connection_id}.disable<br/>{connection_id}.delete"]
        class cxn_control subjects
        cxn_query["NATS query<br/><b>oe.v1.cxn.query.connections.</b><br/>list<br/>{connection_id}.get"]
        class cxn_query subjects
        cxn_events["NATS events → stream cxn-events<br/><b>oe.v1.cxn.events.connections.{connection_id}.connection.</b><br/>applied<br/>disabled<br/>deleted<br/>degraded<br/>recovered"]
        class cxn_events subjects
        cxn_egress[("stream cxn-egress<br/>cxn.egress.>")]
        class cxn_egress stream
        cxn_ingress[("stream cxn-ingress<br/>cxn.ingress.>")]
        class cxn_ingress stream
        subgraph cxn_db["database cxn"]
            cxn_t_connections[("connections<br/>One per external account OpenEngine hears from: a GitHub App installation, a Slack workspace.")]
            class cxn_t_connections table
        end
    end
    subgraph ge["Graph Engine (ge)"]
        ge_control["NATS control<br/><b>oe.v1.ge.control.</b><br/>graphs.apply<br/>graphs.{graph_id}.run<br/>jobs.submit<br/>jobs.{job_id}.steer<br/>jobs.{job_id}.pause<br/>jobs.{job_id}.resume<br/>jobs.{job_id}.cancel<br/>approvals.{approval_id}.decide<br/>loops.apply<br/>loops.{loop_id}.pause<br/>loops.{loop_id}.resume<br/>loops.{loop_id}.remove"]
        class ge_control subjects
        ge_query["NATS query<br/><b>oe.v1.ge.query.</b><br/>graphs.list<br/>graphs.{graph_id}.get<br/>jobs.list<br/>jobs.{job_id}.get<br/>jobs.{job_id}.executions.list<br/>jobs.{job_id}.workspaces.list<br/>jobs.{job_id}.approvals.list<br/>executions.{execution_id}.get<br/>executions.{execution_id}.steps.list<br/>loops.list<br/>loops.{loop_id}.get<br/>operations.{operation_id}.get"]
        class ge_query subjects
        ge_events["NATS events → stream ge-events<br/><b>oe.v1.ge.events.</b><br/>jobs.{job_id}.job.created<br/>jobs.{job_id}.job.completed<br/>jobs.{job_id}.job.failed<br/>jobs.{job_id}.job.cancelled<br/>jobs.{job_id}.execution.started<br/>jobs.{job_id}.execution.progressed<br/>jobs.{job_id}.execution.awaiting_approval<br/>jobs.{job_id}.execution.paused<br/>jobs.{job_id}.execution.resumed<br/>jobs.{job_id}.execution.completed<br/>jobs.{job_id}.execution.failed<br/>jobs.{job_id}.execution.cancelled<br/>jobs.{job_id}.approval.requested<br/>jobs.{job_id}.approval.resolved<br/>loops.{loop_id}.loop.applied<br/>loops.{loop_id}.loop.paused<br/>loops.{loop_id}.loop.resumed<br/>loops.{loop_id}.loop.removed"]
        class ge_events subjects
        subgraph ge_db["database ge"]
            ge_t_command_receipts[("command_receipts<br/>The reply to every command GE accepted or rejected for good, so a retry with its command ID in its project gets the same one.")]
            class ge_t_command_receipts table
            ge_t_graph_revisions[("graph_revisions<br/>Every revision of every graph, numbered from 1 and never changed once written.")]
            class ge_t_graph_revisions table
            ge_t_graphs[("graphs<br/>One row per graph name in a project. Its ID never changes; applying a changed definition adds a revision.")]
            class ge_t_graphs table
            ge_t_operations[("operations<br/>The durable record of each accepted command's progress, which operations.{operation_id}.get reads.")]
            class ge_t_operations table
            ge_t_graphs --- ge_t_graph_revisions
        end
    end
    subgraph tools["Tool Service (tools)"]
        tools_control["NATS control<br/><b>oe.v1.tools.</b><br/>apply<br/>delete<br/>invoke.{namespace}.{name}<br/>grants.apply<br/>grants.delete<br/>invocations.cancel"]
        class tools_control subjects
        tools_query["NATS query<br/><b>oe.v1.tools.</b><br/>get<br/>list<br/>grants.get<br/>grants.list<br/>invocations.get<br/>invocations.list"]
        class tools_query subjects
        tools_events["NATS events → stream tools-events<br/><b>oe.v1.tools.events.invocations.{namespace}.{invocation_id}.</b><br/>accepted<br/>running<br/>succeeded<br/>failed<br/>blocked-auth<br/>outcome-unknown<br/>cancelled"]
        class tools_events subjects
        subgraph tools_db["database tools"]
            tools_t_tool_grants[("tool_grants<br/>Who may call which tool. tool_uid is the tool the grant was bound to when applied; a grant whose tool has since been replaced denies every call.")]
            class tools_t_tool_grants table
            tools_t_tool_invocation_attempts[("tool_invocation_attempts<br/>Each try at an invocation. idempotency_key is what a provider-idempotent tool repeats on every attempt; outcome stays null while an attempt runs or when an interrupted one could not be reconciled.")]
            class tools_t_tool_invocation_attempts table
            tools_t_tool_invocations[("tool_invocations<br/>One accepted call. The resolved tool definition is copied in, so changing or deleting the Tool cannot change accepted work; grant_refs names the grants that allowed it, checked again before every dispatch.")]
            class tools_t_tool_invocations table
            tools_t_tools[("tools<br/>An invocable capability bound to one connection, as last applied.")]
            class tools_t_tools table
            tools_t_tool_invocations --- tools_t_tool_invocation_attempts
        end
    end
    subgraph vcp["Virtual Control Plane (vcp)"]
        vcp_control["NATS control<br/><b>oe.v1.vcp.control.</b><br/>workspaces.apply<br/>workspaces.{workspace_id}.ensure<br/>workspaces.{workspace_id}.execute<br/>workspaces.{workspace_id}.steer<br/>workspaces.{workspace_id}.cancel<br/>workspaces.{workspace_id}.checkpoint<br/>workspaces.{workspace_id}.suspend<br/>workspaces.{workspace_id}.destroy<br/>approvals.{approval_id}.decide"]
        class vcp_control subjects
        vcp_query["NATS query<br/><b>oe.v1.vcp.query.</b><br/>capabilities.get<br/>workspaces.list<br/>workspaces.{workspace_id}.get<br/>workspaces.{workspace_id}.sessions.list<br/>workspaces.{workspace_id}.approvals.list<br/>workspaces.{workspace_id}.artifacts.list<br/>sessions.{session_id}.get<br/>sessions.{session_id}.events.list<br/>operations.{operation_id}.get"]
        class vcp_query subjects
        vcp_events["NATS events → stream vcp-events<br/><b>oe.v1.vcp.events.workspaces.{workspace_id}.</b><br/>workspace.provisioning<br/>workspace.ready<br/>workspace.restored<br/>workspace.checkpointed<br/>workspace.suspended<br/>workspace.destroyed<br/>workspace.failed<br/>task.started<br/>task.completed<br/>task.failed<br/>task.cancelled<br/>approval.requested<br/>approval.resolved<br/>approval.expired<br/>steering.applied<br/>steering.failed<br/>conversation.message<br/>usage.reported<br/>artifact.created"]
        class vcp_events subjects
        subgraph vcp_db["database vcp"]
            vcp_t_command_receipts[("command_receipts<br/>Public command idempotency: a retry with the same command ID returns the original receipt.")]
            class vcp_t_command_receipts table
            vcp_t_cursors[("cursors<br/>Durable, opaque keyset positions bound to the filters a paginated query was issued with.")]
            class vcp_t_cursors table
            vcp_t_operations[("operations<br/>The durable record of each accepted command's progress, returned by operations.{operation_id}.get.")]
            class vcp_t_operations table
            vcp_t_outbox[("outbox<br/>Public events accepted atomically with their causing state change, not yet published.")]
            class vcp_t_outbox table
            vcp_t_runtime_ownership[("runtime_ownership<br/>Which runtime currently owns a workspace, and at which generation.")]
            class vcp_t_runtime_ownership table
            vcp_t_workspace_records[("workspace_records<br/>The durable workspace lifecycle projection: state, runtime binding and version.")]
            class vcp_t_workspace_records table
            vcp_t_workspaces[("workspaces<br/>A place an agent does its work, on whichever provider supplied it.")]
            class vcp_t_workspaces table
        end
    end

    subgraph virtualization["Virtualization"]
        direction TB
        provider["workspace provider<br/>such as process, smolvm, kubernetes"]
        subgraph runtime["runtime, generation n<br/>isolation: process · container · microvm · vm"]
            direction TB
            daemon["workspace daemon"]
            sessions["agent sessions and task attempts"]
            checkout[("workspace checkout")]
            daemon --> sessions --> checkout
        end
        restored["runtime, generation n+1<br/>restored from a checkpoint"]
        provider -- "provisions" --> runtime
        runtime -. "suspend, restore" .-> restored
    end
    class provider,daemon,sessions,checkout,restored runtime

    %% Who calls what.
    cli --> ge_control & ge_query
    cli -- "connections" --> cxn_control & cxn_query
    supervisor -. "starts" .-> nats
    github -- "webhooks" --> cxn_ingress
    github --- |"← API calls"| cxn_egress
    slack -- "webhooks" --> cxn_ingress
    slack --- |"← API calls"| cxn_egress
    cxn -- "jobs" --> ge_control
    ge -- "workspaces" --> vcp_control
    vcp_events -. "workspace and task events" .-> ge
    vcp -- "provision, suspend, restore" --> provider
    vcp -- "execute, steer, cancel" --> daemon
    tools_control --- |"← invoke tools"| sessions
    ge -- "tool grants" --> tools_control
    cxn_query --- |"read by tools"| tools
