        supervisor["supervisor (oe up)"]
    end
    subgraph integrations["Integrations"]
        github["GitHub"]
        slack["Slack"]
    end
    class cli,supervisor app
    class github,slack integration
    nats[("NATS server")]
    class nats stream
    subgraph cxn["Connection Bus (cxn)"]
        cxn_control["NATS control<br/><b>oe.v1.cxn.control.</b><br/>connections.add<br/>connections.{connection_id}.configure<br/>connections.{connection_id}.disable<br/>connections.{connection_id}.delete"]
        class cxn_control subjects
        cxn_query["NATS query<br/><b>oe.v1.cxn.query.</b><br/>connections.list<br/>connections.{connection_id}.get"]
        class cxn_query subjects
        cxn_events["NATS events → stream cxn-events<br/><b>oe.v1.cxn.events.</b><br/>connections.{connection_id}.connection.added<br/>connections.{connection_id}.connection.configured<br/>connections.{connection_id}.connection.disabled<br/>connections.{connection_id}.connection.deleted<br/>connections.{connection_id}.connection.degraded<br/>connections.{connection_id}.connection.recovered"]
        class cxn_events subjects
        cxn_egress[("stream cxn-egress<br/>cxn.egress.>")]
        class cxn_egress stream
        cxn_ingress[("stream cxn-ingress<br/>cxn.ingress.>")]
        class cxn_ingress stream
        subgraph cxn_db["database cxn"]
            cxn_t_connections[("connections")]
            class cxn_t_connections table
        end
    end
    subgraph ge["Graph Engine (ge)"]
        ge_control["NATS control<br/><b>oe.v1.ge.control.</b><br/>graphs.add<br/>graphs.{graph_id}.run<br/>jobs.submit<br/>jobs.{job_id}.steer<br/>jobs.{job_id}.pause<br/>jobs.{job_id}.resume<br/>jobs.{job_id}.cancel<br/>approvals.{approval_id}.decide<br/>loops.add<br/>loops.{loop_id}.configure<br/>loops.{loop_id}.pause<br/>loops.{loop_id}.resume<br/>loops.{loop_id}.remove"]
        class ge_control subjects
        ge_query["NATS query<br/><b>oe.v1.ge.query.</b><br/>graphs.list<br/>graphs.{graph_id}.get<br/>jobs.list<br/>jobs.{job_id}.get<br/>jobs.{job_id}.executions.list<br/>jobs.{job_id}.workspaces.list<br/>jobs.{job_id}.approvals.list<br/>executions.{execution_id}.get<br/>executions.{execution_id}.steps.list<br/>loops.list<br/>loops.{loop_id}.get<br/>operations.{operation_id}.get"]
        class ge_query subjects
        ge_events["NATS events → stream ge-events<br/><b>oe.v1.ge.events.</b><br/>jobs.{job_id}.job.created<br/>jobs.{job_id}.job.completed<br/>jobs.{job_id}.job.failed<br/>jobs.{job_id}.job.cancelled<br/>jobs.{job_id}.execution.started<br/>jobs.{job_id}.execution.progressed<br/>jobs.{job_id}.execution.awaiting_approval<br/>jobs.{job_id}.execution.paused<br/>jobs.{job_id}.execution.resumed<br/>jobs.{job_id}.execution.completed<br/>jobs.{job_id}.execution.failed<br/>jobs.{job_id}.execution.cancelled<br/>jobs.{job_id}.approval.requested<br/>jobs.{job_id}.approval.resolved<br/>loops.{loop_id}.loop.added<br/>loops.{loop_id}.loop.configured<br/>loops.{loop_id}.loop.paused<br/>loops.{loop_id}.loop.resumed<br/>loops.{loop_id}.loop.removed"]
        class ge_events subjects
        subgraph ge_db["database ge"]
            ge_t_graphs[("graphs")]
            class ge_t_graphs table
        end
    end
    subgraph vcp["Virtual Control Plane (vcp)"]
        vcp_control["NATS control<br/><b>oe.v1.vcp.control.</b><br/>workspaces.create<br/>workspaces.{workspace_id}.ensure<br/>workspaces.{workspace_id}.execute<br/>workspaces.{workspace_id}.steer<br/>workspaces.{workspace_id}.cancel<br/>workspaces.{workspace_id}.checkpoint<br/>workspaces.{workspace_id}.suspend<br/>workspaces.{workspace_id}.destroy<br/>approvals.{approval_id}.decide"]
        class vcp_control subjects
        vcp_query["NATS query<br/><b>oe.v1.vcp.query.</b><br/>capabilities.get<br/>workspaces.list<br/>workspaces.{workspace_id}.get<br/>workspaces.{workspace_id}.sessions.list<br/>workspaces.{workspace_id}.approvals.list<br/>workspaces.{workspace_id}.artifacts.list<br/>sessions.{session_id}.get<br/>sessions.{session_id}.events.list<br/>operations.{operation_id}.get"]
        class vcp_query subjects
        vcp_events["NATS events → stream vcp-events<br/><b>oe.v1.vcp.events.</b><br/>workspaces.{workspace_id}.workspace.provisioning<br/>workspaces.{workspace_id}.workspace.ready<br/>workspaces.{workspace_id}.workspace.restored<br/>workspaces.{workspace_id}.workspace.checkpointed<br/>workspaces.{workspace_id}.workspace.suspended<br/>workspaces.{workspace_id}.workspace.destroyed<br/>workspaces.{workspace_id}.workspace.failed<br/>workspaces.{workspace_id}.task.started<br/>workspaces.{workspace_id}.task.completed<br/>workspaces.{workspace_id}.task.failed<br/>workspaces.{workspace_id}.task.cancelled<br/>workspaces.{workspace_id}.approval.requested<br/>workspaces.{workspace_id}.approval.resolved<br/>workspaces.{workspace_id}.approval.expired<br/>workspaces.{workspace_id}.steering.applied<br/>workspaces.{workspace_id}.steering.failed<br/>workspaces.{workspace_id}.conversation.message<br/>workspaces.{workspace_id}.usage.reported<br/>workspaces.{workspace_id}.artifact.created"]
        class vcp_events subjects
        subgraph vcp_db["database vcp"]
            vcp_t_workspaces[("workspaces")]
            class vcp_t_workspaces table
        end
    end

    subgraph virtualization["Virtualization"]
        direction TB
        provider["workspace provider<br/>such as process, smolvm, kubernetes"]
        subgraph runtime["runtime, generation n<br/>isolation: process · container · microvm · vm"]
            direction TB
            daemon["workspace daemon"]
            sessions["agent sessions and task attempts"]
            checkout[("workspace checkout")]
            daemon --> sessions --> checkout
        end
        restored["runtime, generation n+1<br/>restored from a checkpoint"]
        provider -- "provisions" --> runtime
        runtime -. "suspend, restore" .-> restored
    end
    class provider,daemon,sessions,checkout,restored runtime

    %% Who calls what.
    cli --> ge_control & ge_query
    cli -- "connections" --> cxn_control & cxn_query
    supervisor -. "starts" .-> nats
    github -- "webhooks" --> cxn_ingress
    github --- |"← API calls"| cxn_egress
    slack -- "webhooks" --> cxn_ingress
    slack --- |"← API calls"| cxn_egress
    cxn -- "jobs" --> ge_control
    ge -- "workspaces" --> vcp_control
    vcp_events -. "workspace and task events" .-> ge
    vcp -- "provision, suspend, restore" --> provider
    vcp -- "execute, steer, cancel" --> daemon
