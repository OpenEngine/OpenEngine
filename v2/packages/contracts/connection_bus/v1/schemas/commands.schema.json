{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connection Bus commands",
  "description": "Requests and responses of `oe.v1.cxn.control.…`. The connection named in the subject is the target; payloads do not repeat it.",
  "$defs": {
    "add_connection_command": {
      "allOf": [
        { "$ref": "../../../common/v1/command.schema.json" },
        { "properties": { "payload": { "$ref": "#/$defs/add_connection_payload" } } }
      ]
    },
    "add_connection_payload": {
      "type": "object",
      "required": ["provider", "external_account", "credential_ref", "scope"],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "connection.schema.json#/$defs/provider" },
        "display_name": {
          "description": "Defaults to the external account's name, or its ID.",
          "$ref": "connection.schema.json#/$defs/display_name"
        },
        "external_account": { "$ref": "connection.schema.json#/$defs/external_account" },
        "credential_ref": { "$ref": "connection.schema.json#/$defs/credential_ref" },
        "scope": { "$ref": "connection.schema.json#/$defs/scope" },
        "settings": { "$ref": "connection.schema.json#/$defs/settings", "default": {} }
      }
    },
    "configure_connection_command": {
      "allOf": [
        { "$ref": "../../../common/v1/command.schema.json" },
        { "properties": { "payload": { "$ref": "#/$defs/configure_connection_payload" } } }
      ]
    },
    "configure_connection_payload": {
      "description": "Fields to replace; omitted fields are unchanged. `enabled: true` re-enables a disabled connection (and resumes held deliveries); disabling goes through `disable`. A deleted connection rejects with INVALID_STATE.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "display_name": { "$ref": "connection.schema.json#/$defs/display_name" },
        "credential_ref": { "$ref": "connection.schema.json#/$defs/credential_ref" },
        "scope": { "$ref": "connection.schema.json#/$defs/scope" },
        "settings": { "$ref": "connection.schema.json#/$defs/settings" },
        "enabled": { "const": true }
      }
    },
    "disable_connection_command": {
      "allOf": [
        { "$ref": "../../../common/v1/command.schema.json" },
        { "properties": { "payload": { "$ref": "#/$defs/disable_connection_payload" } } }
      ]
    },
    "disable_connection_payload": {
      "description": "Stop new integration activity: ingress for the connection is refused at the provider edge and no new egress is accepted. Configuration and bindings are kept. Disabling an already-disabled connection is accepted and changes nothing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_flight": { "$ref": "connection.schema.json#/$defs/in_flight_on_disable" },
        "reason": { "type": "string", "maxLength": 2048 }
      }
    },
    "delete_connection_command": {
      "allOf": [
        { "$ref": "../../../common/v1/command.schema.json" },
        { "properties": { "payload": { "$ref": "#/$defs/delete_connection_payload" } } }
      ]
    },
    "delete_connection_payload": {
      "description": "Remove the connection's configuration and bindings. Historical jobs, deliveries and audit records that reference it are kept, and its ID is never reused. An active connection is disabled as part of deletion.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_flight": { "$ref": "connection.schema.json#/$defs/in_flight_on_delete" },
        "reason": { "type": "string", "maxLength": 2048 }
      }
    },
    "connection_command_response": {
      "description": "Reply to every CXN command. `resource_id` is the connection ID; `add` allocates it at acceptance.",
      "allOf": [
        { "$ref": "../../../common/v1/command-response.schema.json" },
        {
          "properties": {
            "resource_id": { "$ref": "../../../common/v1/types.schema.json#/$defs/connection_id" }
          }
        }
      ]
    }
  }
}
