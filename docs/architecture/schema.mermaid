        TEXT decided_at "nullable"
    }
    state_agent_instances ||--o{ state_approvals : "instance_id"
    state_legacy_run_metadata {
        INTEGER sequence PK "not null"
        TEXT run_id "not null"
        TEXT state_json "not null"
        TEXT requester "nullable"
