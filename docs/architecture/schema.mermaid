erDiagram
    %% Latest Alembic schema; state_ = sqlite, graph_ = sqlite_graph.
    %% PK/FK/UK are database constraints. Composite keys share the same marker.
    %% Solid edges: declared FK. Dashed edges: logical references, not FK constraints.
    %% PostgreSQL has no application tables. LangGraph checkpoints are separately managed.
    direction LR
    %% sqlite heads: 9668c9dcd56a
    state_agent_instances {
        INTEGER sequence PK "not null"
        TEXT instance_id UK "not null"
        TEXT agent_id "not null"
        TEXT conversation_id UK "not null"
        TEXT task_id "nullable"
        TEXT workspace_id "nullable"
        TEXT title "not null"
        INTEGER archived "not null"
        TEXT runner "not null"
        INTEGER auto_approve "not null"
        TEXT workflow_run_id "nullable"
        TEXT workflow_step_id "nullable"
    }
    state_agent_runs {
        TEXT agent_run_id PK "not null"
        TEXT instance_id FK "not null"
        TEXT status "not null"
        TEXT summary "not null"
        TEXT changed_files "not null"
        TEXT runner "not null"
    }
    state_agent_instances ||--o{ state_agent_runs : "instance_id"
    state_approvals {
        INTEGER sequence PK "not null"
        TEXT approval_id UK "not null"
        TEXT agent_run_id "not null"
