# Copy outside the checkout, chmod 600, and replace every placeholder.
# Generate a token with: openssl rand -hex 32
OE_MCP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
OE_MCP_REPOSITORY=/Users/YOU/code/OpenEngine
OE_MCP_WORKFLOW=implementation-review-rerank
OE_MCP_ENGINE_URL=http://127.0.0.1:8000
OE_MCP_PUBLIC_URL=https://YOUR-MINI.YOUR-TAILNET.ts.net

# Optional OAuth mode: leave ALL settings below unset for static-token access.
# Any of these settings without an issuer fails startup, even if empty.
# Access tokens must include email_verified as boolean true and an allowed email.
# Setting the issuer switches to external OIDC tokens; the allowlist is REQUIRED.
# Configure the same user restriction at the identity provider.
# OE_MCP_OIDC_ISSUER=https://YOUR-IDENTITY-PROVIDER.example
# OE_MCP_ALLOWED_EMAILS=you@example.com
# Defaults to OE_MCP_PUBLIC_URL + /mcp; any explicit value must match.
# OE_MCP_OIDC_AUDIENCE=https://YOUR-MINI.YOUR-TAILNET.ts.net/mcp
# Optional space-separated required access-token scopes:
# OE_MCP_OIDC_REQUIRED_SCOPES=work:create
